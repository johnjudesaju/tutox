generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  name        String
  designation String
  roles       String
  mobile      String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
}